<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <aspNetCore processPath="dotnet" 
                  arguments=".\Luma.API.WebApi.dll" 
                  stdoutLogEnabled="true" 
                  stdoutLogFile=".\logs\stdout" 
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Environment: Production, Development, Staging, etc. -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- 
            ASPNETCORE_URLS: With inprocess hosting, IIS handles HTTP/HTTPS binding directly.
            The app doesn't need to bind to ports itself - IIS manages this.
            Format: https://+:HTTPS_PORT;http://+:HTTP_PORT
            Example: https://+:8094;http://+:8084
            Each client can customize these ports based on their IIS configuration.
          -->
          <environmentVariable name="ASPNETCORE_URLS" value="https://+:8094;http://+:8084" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>

