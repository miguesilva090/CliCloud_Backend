{
  "_comment": "This is a template file for client-specific production configuration.",
  "_comment2": "Copy this file to appsettings.Production.json and fill in client-specific values.",
  "_comment3": "This file should NOT be included in the build/deployment package.",
  "_comment4": "Each client should have their own appsettings.Production.json file.",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=YOUR_DATABASE_NAME;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=true;MultipleActiveResultSets=true;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JWTSettings": {
    "Key": "GENERATE_A_STRONG_RANDOM_KEY_FOR_THIS_CLIENT",
    "Issuer": "CoreIdentity",
    "Audience": "CoreIdentityUser",
    "AuthTokenDurationInMinutes": 30,
    "RefreshTokenDurationInDays": 14
  },
  "MailSettings": {
    "DisplayName": "Luma Message",
    "From": "noreply@clientdomain.com",
    "Host": "smtp.clientdomain.com",
    "Password": "SMTP_PASSWORD",
    "Port": 587,
    "UserName": "SMTP_USERNAME"
  },
  "Cloudinary": {
    "CloudName": "CLIENT_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "CLIENT_CLOUDINARY_API_KEY",
    "ApiSecret": "CLIENT_CLOUDINARY_API_SECRET",
    "ApiBaseAddress": "https://api.cloudinary.com"
  },
  "EncryptionSettings": {
    "EncryptionKey": "GENERATE_A_STRONG_16_CHARACTER_KEY"
  },
  "RateLimiting": {
    "MaxRequests": 100,
    "WindowSeconds": 60,
    "ExcludedPaths": []
  }
}

